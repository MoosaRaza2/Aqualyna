{% comment %} 
  Shopify Snippet: Clickable Text → Open Image (No White Space) 
  WITH FULL SCHEMA SETTINGS 
  Usage: Add as a "Custom Liquid" section or include in a template
{% endcomment %}

{% style %}
  /* NO WHITESPACE around image or modal */
  .image-modal-{{ section.id }} {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ section.settings.modal_overlay_color | default: 'rgba(0, 0, 0, 0.92)' }};
    justify-content: center;
    align-items: center;
    z-index: 9999;
    cursor: pointer;
    margin: 0;
    padding: 0;
  }
  .image-modal-{{ section.id }}
  img {
    max-width: {{ section.settings.max_image_width | default: 90 }}vw;
    max-height: {{ section.settings.max_image_height | default: 90 }}vh;
    object-fit: contain;
    border-radius: {{ section.settings.image_border_radius | default: 8 }}px;
    box-shadow: 0 20px 35px rgba(0, 0, 0, 0.4);
    display: block;
    margin: 0;
    padding: 0;
    border: 0;
  }
  /* clickable text style — no margin/padding/whitespace around */
  .clickable-image-text-{{ section.id }} {
    display: inline-block;
    cursor: pointer;
   font-size: 16px;
   transition: opacity 0.2s ease;
}

.clickable-image-text-{{ section.id }}:hover {
  opacity: 0.8;
  {% if section.settings.hover_underline %}text-decoration: underline;
{% endif %}
}
/* add optional icon before text */
/* .clickable-image-text-{{ section.id }}::before {
  content: "{{ section.settings.prefix_icon | default: '📸' }} ";
  display: inline;
} */
/* ensure no wrapper adds hidden spacing */
.text-trigger-wrapper-{{ section.id }} {
  margin: 0;
  padding: 0;
  display: inline;
}
/* optional container alignment */
.clickable-container-{{ section.id }} {
  margin-bottom: 10px;
  padding: {{ section.settings.container_padding | default: 0 }}px;
  text-align: {{ section.settings.text_alignment | default: 'left' }};
}
{% endstyle %}

<!-- clickable text trigger — 0 whitespace around it -->
<div class="clickable-container-{{ section.id }}">
  <span class="text-trigger-wrapper-{{ section.id }}">
    <span class="clickable-image-text-{{ section.id }}" id="openImageViewer-{{ section.id }}">
      {{ section.settings.clickable_text | default: 'View full image' }}
    </span>
  </span>
</div>

<!-- hidden modal: pure image without any white padding/margins -->
<div
  id="imageModal-{{ section.id }}"
  class="image-modal-{{ section.id }}"
  style="display: none;">
  <img
    id="modalImage-{{ section.id }}"
    src=""
    alt="{{ section.settings.image_alt | default: 'Full size preview' }}">
</div>

<script>
    (function() {
      const sectionId = {{ section.id | json }};
      const modal = document.getElementById('imageModal-' + sectionId);
      const modalImg = document.getElementById('modalImage-' + sectionId);
      const trigger = document.getElementById('openImageViewer-' + sectionId);
      
      // Get image URL from settings
      const imageUrl = {{ section.settings.image | img_url: 'master' | json }};
      const customImageUrl = {{ section.settings.custom_image_url | json }};
      const useCustomUrl = {{ section.settings.use_custom_url | json }};
      
      // Determine which image to use
      let finalImageUrl = '';
      if (useCustomUrl && customImageUrl && customImageUrl.trim() !== '') {
        finalImageUrl = customImageUrl;
      } else if (imageUrl && imageUrl !== '') {
        finalImageUrl = imageUrl;
      } else {
        finalImageUrl = 'https://cdn.shopify.com/s/files/1/0538/8579/2431/files/placeholder.png'; // fallback
      }
      
      // Open modal
      function openModal() {
        if (!finalImageUrl) return;
        modalImg.src = finalImageUrl;
        modal.style.display = 'flex';
        document.body.style.overflow = 'hidden';
        
        // Optional: add animation class
        modal.style.animation = 'fadeInModal 0.2s ease';
      }
      
      // Close modal
      function closeModal() {
        modal.style.display = 'none';
        modalImg.src = '';
        document.body.style.overflow = '';
      }
      
      // Event listeners
      if (trigger) {
        trigger.addEventListener('click', openModal);
      }
      
      if (modal) {
        modal.addEventListener('click', closeModal);
      }
      
      // ESC key support
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && modal && modal.style.display === 'flex') {
          closeModal();
        }
      });
      
      // Add fade-in keyframes if not exists
      if (!document.querySelector('#modalKeyframes')) {
        const style = document.createElement('style');
        style.id = 'modalKeyframes';
        style.textContent = `
          @keyframes fadeInModal {
            from { opacity: 0; }
            to { opacity: 1; }
          }
        `;
        document.head.appendChild(style);
      }
    })();
</script>