{% comment %} 
  Image Modal Link Snippet 
  Usage: {% render 'image-modal-link', text: "View Image", image: section.settings.image %}
{% endcomment %}

{%- assign text_color = style_settings.text_color | default: '#000000' -%}
{%- assign hover_color = style_settings.hover_color | default: '#0066cc' -%}
{%- assign text_size = style_settings.text_size | default: 16 -%}

{%- comment %}Get the image URL correctly{% endcomment %}
{%- if image != blank -%}
  {%- assign modal_image_url = image | image_url -%}
{%- elsif image_url != blank -%}
  {%- assign modal_image_url = image_url -%}
{%- else -%}
  {%- assign modal_image_url = '' -%}
{%- endif -%}

<a
  href="#"
  onclick="event.preventDefault(); openModalDirectly('{{ modal_image_url }}', '{{ text | escape }}'); return false;"
  class="image-modal-link"
  style="color: {{ text_color }}; font-size: {{ text_size }}px; text-decoration: underline; cursor: pointer; display: inline-block;">
  {{ text | default: 'Click here to view image' }}
</a>

<script>
  // Simple, reliable modal function
  function openModalDirectly(imageUrl, title) {
  console.log('Opening modal with URL:', imageUrl);
  
  if (!imageUrl || imageUrl === '') {
    alert('Error: No image URL provided. Please select an image in the section settings.');
    return;
  }
  
  // Create modal if it doesn't exist
  let modal = document.getElementById('simpleImageModal');
  if (!modal) {
    modal = document.createElement('div');
    modal.id = 'simpleImageModal';
    modal.innerHTML = `
      <div id="simpleModalOverlay" style="display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.9); z-index: 999999; cursor: pointer;">
        <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); background: white; padding: 20px; border-radius: 8px; max-width: 90%; max-height: 90vh; overflow: auto; cursor: default;">
          <button id="simpleModalClose" style="position: absolute; top: 10px; right: 10px; background: none; border: none; font-size: 28px; cursor: pointer; color: #333; z-index: 10;">&times;</button>
          <img id="simpleModalImage" src="" alt="" style="max-width: 100%; height: auto; display: block;">
          <div id="simpleModalError" style="color: red; display: none; text-align: center; padding: 20px;">Failed to load image</div>
        </div>
      </div>
    `;
    document.body.appendChild(modal);
    
    // Close functionality
    document.getElementById('simpleModalOverlay').addEventListener('click', function(e) {
      if (e.target === this || e.target.id === 'simpleModalClose') {
        this.style.display = 'none';
        document.body.style.overflow = '';
      }
    });
    
    // Escape key handler
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        const overlay = document.getElementById('simpleModalOverlay');
        if (overlay && overlay.style.display === 'block') {
          overlay.style.display = 'none';
          document.body.style.overflow = '';
        }
      }
    });
  }
  
  // Show modal and set image
  const overlay = document.getElementById('simpleModalOverlay');
  const modalImg = document.getElementById('simpleModalImage');
  const errorDiv = document.getElementById('simpleModalError');
  
  // Reset
  modalImg.style.display = 'block';
  errorDiv.style.display = 'none';
  modalImg.src = '';
  
  // Set new image
  modalImg.onerror = function() {
    errorDiv.style.display = 'block';
    modalImg.style.display = 'none';
    console.error('Failed to load image:', imageUrl);
  };
  
  modalImg.onload = function() {
    errorDiv.style.display = 'none';
    modalImg.style.display = 'block';
  };
  
  modalImg.src = imageUrl;
  modalImg.alt = title || 'Image';
  overlay.style.display = 'block';
  document.body.style.overflow = 'hidden';
  }
</script>