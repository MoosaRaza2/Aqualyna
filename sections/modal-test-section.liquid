<div style="text-align: {{ section.settings.alignment }}; padding: 40px 20px;">
  <h3>{{ section.settings.heading }}</h3>
  
  {% render 'image-modal-link',
     text: section.settings.button_text,
     image: section.settings.modal_image,
     style_settings: section.settings
  %}
  
  {% if section.settings.show_debug %}
    <div style="margin-top: 20px; padding: 10px; background: #f0f0f0; font-size: 12px;">
      <strong>Debug Info:</strong><br>
      Image selected: {% if section.settings.modal_image != blank %}Yes ({{ section.settings.modal_image | image_url }}){% else %}No image selected{% endif %}
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Modal Test Section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Test Modal"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Click to Open Image"
    },
    {
      "type": "image_picker",
      "id": "modal_image",
      "label": "Select Image",
      "info": "Choose an image to display in the modal"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "default": "center",
      "options": [
        {"value": "left", "label": "Left"},
        {"value": "center", "label": "Center"},
        {"value": "right", "label": "Right"}
      ]
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "hover_color",
      "label": "Hover Color",
      "default": "#0066cc"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text Size (px)",
      "min": 12,
      "max": 48,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "show_debug",
      "label": "Show debug info",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Modal Test",
      "category": "Custom"
    }
  ]
}
{% endschema %}